{
  "schema_version": "1.0",
  "rule": {
    "path": "wazuh/custom-rules/100100-suspicious-powershell.xml",
    "rule_id": "100100",
    "level": 10,
    "required_group": "sysmon_event1",
    "field_names": [
      "win.eventdata.image",
      "win.eventdata.commandLine"
    ],
    "description": "Suspicious PowerShell encoded-command invocation attempt detected; investigation is required.",
    "mitre_ids": [
      "T1059.001"
    ]
  },
  "cases": [
    {
      "case_id": "P1",
      "category": "positive",
      "synthetic_event": {
        "win.system.eventID": 1,
        "groups": ["sysmon_event1"],
        "win.eventdata.image": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "win.eventdata.commandLine": "\"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -EncodedCommand SYNTHETIC-TEST-DATA"
      },
      "expected": {"match_status": "match", "rule_id": "100100", "level": 10},
      "rationale": "Exact full switch follows the executable."
    },
    {
      "case_id": "P2",
      "category": "positive",
      "synthetic_event": {
        "win.system.eventID": 1,
        "groups": ["sysmon_event1"],
        "win.eventdata.image": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "win.eventdata.commandLine": "powershell.exe -enc SYNTHETIC-TEST-DATA"
      },
      "expected": {"match_status": "match", "rule_id": "100100", "level": 10},
      "rationale": "Exact abbreviation follows the executable."
    },
    {
      "case_id": "P3",
      "category": "positive",
      "synthetic_event": {
        "win.system.eventID": 1,
        "groups": ["sysmon_event1"],
        "win.eventdata.image": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
        "win.eventdata.commandLine": "\"C:\\Program Files\\PowerShell\\7\\pwsh.exe\" -eNc SYNTHETIC-TEST-DATA"
      },
      "expected": {"match_status": "match", "rule_id": "100100", "level": 10},
      "rationale": "Matching is case-insensitive."
    },
    {
      "case_id": "P4",
      "category": "positive",
      "synthetic_event": {
        "win.system.eventID": 1,
        "groups": ["sysmon_event1"],
        "win.eventdata.image": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "win.eventdata.commandLine": "\"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -EncodedCommand SYNTHETIC-TEST-DATA"
      },
      "expected": {"match_status": "match", "rule_id": "100100", "level": 10},
      "rationale": "A supported launcher option may precede the switch."
    },
    {
